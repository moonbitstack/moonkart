// Native-only persistence: an append log on disk behind a memory cache.
import {
  "moonbitstack/moonkart",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/buffer",
}

options(
  targets: { "disk_native.mbt": [ "native" ] },
  warnings: "-29",
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)
