// Native-only persistence: an append log on disk behind a memory cache.
import {
  "moonbitstack/moonkart",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/io",
  "moonbitlang/core/buffer",
}

options(
  targets: {
    "disk_native.mbt": [ "native" ],
    "disk_native_wbtest.mbt": [ "native" ],
  },
  warnings: "-29",
)
