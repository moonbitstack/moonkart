///|
/// The first 10,000 requests of the ARC OLTP trace, one key per request. The
/// full trace is 914,145 requests over 186,880 keys; the offline test replays
/// this prefix so CI needs no downloaded data. Source: the `arc` directory of
/// the cache-trace dataset described in the ARC paper (FAST 2003).
pub fn truncated_oltp() -> Array[Int32] {
  let out : Array[Int32] = []
  out.append(chunk_00())
  out.append(chunk_01())
  out.append(chunk_02())
  out.append(chunk_03())
  out.append(chunk_04())
  out.append(chunk_05())
  out.append(chunk_06())
  out.append(chunk_07())
  out.append(chunk_08())
  out.append(chunk_09())
  out.append(chunk_10())
  out.append(chunk_11())
  out.append(chunk_12())
  out.append(chunk_13())
  out.append(chunk_14())
  out.append(chunk_15())
  out.append(chunk_16())
  out.append(chunk_17())
  out.append(chunk_18())
  out.append(chunk_19())
  out
}

